{% include "py_head.inc" %}
METHOD = {{ method|pyrepr }}
PARAM_TYPES = {{ param_types|pyrepr }}
OUT_TYPE = {{ out_type|pyrepr }}
OUT_INDEX = {{ out_index|pyrepr }}  # in-place output param index, or None
{% include "py_common.inc" %}def main(res_fd, sol_path, state):
    res = os.fdopen(res_fd, "w", encoding="utf-8", buffering=1)
    mod = load_solution(sol_path)

    def report(test_id, status, ns, message, output):
        res.write(
            json.dumps(
                {
                    "id": test_id,
                    "status": status,
                    "time_ns": ns,
                    "mem_kb": peak_kb(),
                    "message": message,
                    "output": output,
                },
                separators=(",", ":"),
                ensure_ascii=False,
            )
            + "\n"
        )
        res.flush()

    for line in sys.stdin:
        line = line.rstrip("\n")
        if "\t" not in line:
            continue
        test_id, path = line.split("\t", 1)
        try:
            with open(path, encoding="utf-8") as f:
                raw = [json.loads(x) for x in f.read().splitlines() if x.strip()]
            if len(raw) != len(PARAM_TYPES):
                raise ValueError(f"expected {len(PARAM_TYPES)} input lines, got {len(raw)}")
            args = [convert_in(t, v) for t, v in zip(PARAM_TYPES, raw)]
        except Exception as e:
            report(test_id, "input", 0, repr(e), None)
            continue
        t0 = t1 = 0
        status, message, output = "ok", "", None
        try:
            fn = getattr(mod.Solution(), METHOD)
            t0 = time.perf_counter_ns()
            ret = fn(*args)
            t1 = time.perf_counter_ns()
            value = args[OUT_INDEX] if OUT_INDEX is not None else ret
            output = convert_out(OUT_TYPE, value)
        except MemoryError:
            status, message = "oom", "MemoryError"
        except RecursionError as e:
            status, message = "stackoverflow", solution_trace(e, sol_path)
        except BaseException as e:  # noqa: BLE001 - SystemExit from user code is a runtime error too
            status, message = "exception", solution_trace(e, sol_path)
        if t0 and not t1:
            t1 = time.perf_counter_ns()
        report(test_id, status, t1 - t0, message, output)
    state["ok"] = True


